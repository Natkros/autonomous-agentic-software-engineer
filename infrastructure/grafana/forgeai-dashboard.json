{
  "title": "ForgeAI Tool Execution",
  "uid": "forgeai-tool-execution",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Tool calls per second by tool",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (tool_name) (rate(forgeai_tool_calls_total[5m]))",
          "legendFormat": "{{tool_name}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Tool call failure rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (tool_name) (rate(forgeai_tool_calls_total{success=\"False\"}[5m])) / sum by (tool_name) (rate(forgeai_tool_calls_total[5m]))",
          "legendFormat": "{{tool_name}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "p95 tool call duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, tool_name) (rate(forgeai_tool_call_duration_seconds_bucket[5m])))",
          "legendFormat": "{{tool_name}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Total tool calls (all time window)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum(forgeai_tool_calls_total)" }
      ]
    }
  ]
}
